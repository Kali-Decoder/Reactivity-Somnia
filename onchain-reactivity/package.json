{
  "name": "hardhat-project",
  "scripts": {
    "deploy": "hardhat run scripts/deploy.ts --network somniaTestnet",
    "create-subscription": "npx ts-node scripts/create-subscription.ts",
    "manage-subscription": "npx ts-node scripts/manage-subscription.ts",
    "test-chest": "CHEST_TYPE=${CHEST_TYPE:-COMMON} hardhat run scripts/test-chest.ts --network somniaTestnet",
